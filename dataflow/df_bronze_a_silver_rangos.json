				"          descripcion_rango as string,",
				"          categoria_rango as string,",
				"          fuerza as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenBronzeRangos",
