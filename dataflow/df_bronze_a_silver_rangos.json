				"          id_rango,",
				"          descripcion_rango,",
				"          categoria_rango,",
				"          fuerza",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> MapeoRangos",
				"MapeoRangos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_rango as integer,",
				"          descripcion_rango as string,",
				"          categoria_rango as string,",
				"          fuerza as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> DestinoSilverRangos"
			]
		}
	}
}