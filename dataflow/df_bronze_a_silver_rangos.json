		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_tbl_rangos",
						"type": "DatasetReference"
					},
					"name": "OrigenBronzeRangos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_tbl_rangos",
						"type": "DatasetReference"
					},
					"name": "DestinoSilverRangos"
				}
			],
			"transformations": [
				{
					"name": "MapeoRangos"
				}
