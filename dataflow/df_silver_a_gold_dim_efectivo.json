{
	"name": "df_silver_a_gold_dim_efectivo",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_tbl_efectivos",
						"type": "DatasetReference"
					},
					"name": "OrigenSilverEfectivos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_dim_efectivo",
						"type": "DatasetReference"
					},
					"name": "DestinoGoldDimEfectivo"
				}
			],
			"transformations": [
				{
					"name": "MapeoEfectivos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_efectivo as integer,",
				"          ci as string,",
				"          nombre_completo as string,",
				"          fecha_nacimiento as date,",
				"          genero as string,",
				"          id_rango as integer,",
				"          id_unidad as integer,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenSilverEfectivos",
				"OrigenSilverEfectivos select(mapColumn(",
				"          id_efectivo,",
				"          ci,",
				"          nombre_completo,",
				"          fecha_nacimiento,",
				"          genero,",
				"          id_rango,",
				"          id_unidad,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> MapeoEfectivos",
				"MapeoEfectivos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_efective as integer,",
				"          ci as string,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_efective = id_efectivo,",
				"          ci,",
				"          nombre_completo,",
				"          genero,",
				"          estado",
				"     )) ~> DestinoGoldDimEfectivo"
			]
		}
	}
}