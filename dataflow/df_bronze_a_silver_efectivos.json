{
	"name": "df_bronze_a_silver_efectivos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_tbl_efectivos",
						"type": "DatasetReference"
					},
					"name": "OrigenBronzeEfectivos"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_tbl_efectivos",
						"type": "DatasetReference"
					},
					"name": "DestinoSilverEfectivos"
				}
			],
			"transformations": [
				{
					"name": "ConstruirCamposSilver"
				},
				{
					"name": "MapeoEfectivos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_efectivo as integer,",
				"          ci as string,",
				"          nombre as string,",
				"          paterno as string,",
				"          materno as string,",
				"          fecha_nacimiento as string,",
				"          genero as string,",
				"          id_rango as integer,",
				"          id_unidad as integer,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenBronzeEfectivos",
				"MapeoEfectivos derive(nombre_completo = initCap(nombre),",
				"          paterno = 'No Registrado',",
				"          materno = 'No Registrado') ~> ConstruirCamposSilver",
				"OrigenBronzeEfectivos select(mapColumn(",
				"          id_efectivo,",
				"          ci,",
				"          nombre,",
				"          paterno,",
				"          materno,",
				"          fecha_nacimiento,",
				"          genero,",
				"          id_rango,",
				"          id_unidad,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> MapeoEfectivos",
				"ConstruirCamposSilver sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_efectivo as integer,",
				"          ci as string,",
				"          nombre_completo as string,",
				"          fecha_nacimiento as date,",
				"          genero as string,",
				"          id_rango as integer,",
				"          id_unidad as integer,",
				"          estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> DestinoSilverEfectivos"
			]
		}
	}
}