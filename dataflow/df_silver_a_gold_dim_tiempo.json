{
	"name": "df_silver_a_gold_dim_tiempo",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_movimientos",
						"type": "DatasetReference"
					},
					"name": "movimientos"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_tbl_operaciones",
						"type": "DatasetReference"
					},
					"name": "operacione1"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_tbl_operaciones",
						"type": "DatasetReference"
					},
					"name": "operacion2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_dim_tiempo",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "select2"
				},
				{
					"name": "select3"
				},
				{
					"name": "union1"
				},
				{
					"name": "FechasDistintas"
				},
				{
					"name": "GenerarCampos"
				},
				{
					"name": "FiltrarNulos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fecha as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT fecha_movimiento AS fecha \\nFROM silver.tbl_movimientos_personal\\nWHERE fecha_movimiento IS NOT NULL',",
				"     format: 'query') ~> movimientos",
				"source(output(",
				"          fecha as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT fecha_inicio AS fecha \\nFROM silver.tbl_operaciones\\nWHERE fecha_inicio IS NOT NULL',",
				"     format: 'query') ~> operacione1",
				"source(output(",
				"          fecha as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT fecha_fin AS fecha \\nFROM silver.tbl_operaciones  \\nWHERE fecha_fin IS NOT NULL',",
				"     format: 'query') ~> operacion2",
				"movimientos select(mapColumn(",
				"          fecha",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"operacione1 select(mapColumn(",
				"          fecha",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"operacion2 select(mapColumn(",
				"          fecha",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"select1, select2, select3 union(byName: true)~> union1",
				"union1 aggregate(groupBy(fecha),",
				"     total = count(1)) ~> FechasDistintas",
				"FiltrarNulos derive(id_tiempo = year(fecha)*10000 + month(fecha)*100 + dayOfMonth(fecha),",
				"          anio = year(fecha),",
				"          mes = month(fecha),",
				"          nombre_mes = case(month(fecha)==1,'Enero',month(fecha)==2,'Febrero',month(fecha)==3,'Marzo',month(fecha)==4,'Abril',month(fecha)==5,'Mayo',month(fecha)==6,'Junio',month(fecha)==7,'Julio',month(fecha)==8,'Agosto',month(fecha)==9,'Septiembre',month(fecha)==10,'Octubre',month(fecha)==11,'Noviembre','Diciembre'),",
				"          trimestre = case(month(fecha)<=3,1,month(fecha)<=6,2,month(fecha)<=9,3,4),",
				"          dia_semana = case(dayOfWeek(fecha)==1,'Domingo',dayOfWeek(fecha)==2,'Lunes',dayOfWeek(fecha)==3,'Martes',dayOfWeek(fecha)==4,'Miércoles',dayOfWeek(fecha)==5,'Jueves',dayOfWeek(fecha)==6,'Viernes','Sábado')) ~> GenerarCampos",
				"FechasDistintas filter(!isNull(fecha)) ~> FiltrarNulos",
				"GenerarCampos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_tiempo as integer,",
				"          fecha as date,",
				"          anio as integer,",
				"          mes as integer,",
				"          nombre_mes as string,",
				"          trimestre as integer,",
				"          dia_semana as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     preSQLs:['DELETE FROM gold.dim_tiempo'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_tiempo,",
				"          fecha,",
				"          anio,",
				"          mes,",
				"          nombre_mes,",
				"          trimestre,",
				"          dia_semana",
				"     )) ~> sink1"
			]
		}
	}
}