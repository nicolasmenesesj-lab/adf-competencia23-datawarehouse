		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_a_silver_efectivos')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_tbl_efectivos",
								"type": "DatasetReference"
							},
							"name": "OrigenBronzeEfectivos"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_tbl_efectivos",
								"type": "DatasetReference"
							},
							"name": "DestinoSilverEfectivos"
						}
					],
					"transformations": [
						{
							"name": "ConstruirCamposSilver"
						},
						{
							"name": "MapeoEfectivos"
						}
					],
					"scriptLines": [
						"source(output(",
						"          id_efectivo as integer,",
						"          ci as string,",
						"          nombre as string,",
						"          paterno as string,",
						"          materno as string,",
						"          fecha_nacimiento as string,",
						"          genero as string,",
						"          id_rango as integer,",
						"          id_unidad as integer,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenBronzeEfectivos",
						"MapeoEfectivos derive(nombre_completo = initCap(nombre),",
						"          paterno = 'No Registrado',",
						"          materno = 'No Registrado') ~> ConstruirCamposSilver",
						"OrigenBronzeEfectivos select(mapColumn(",
						"          id_efectivo,",
						"          ci,",
						"          nombre,",
						"          paterno,",
						"          materno,",
						"          fecha_nacimiento,",
						"          genero,",
						"          id_rango,",
						"          id_unidad,",
						"          estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> MapeoEfectivos",
						"ConstruirCamposSilver sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          id_efectivo as integer,",
						"          ci as string,",
						"          nombre_completo as string,",
						"          fecha_nacimiento as date,",
						"          genero as string,",
						"          id_rango as integer,",
						"          id_unidad as integer,",
						"          estado as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> DestinoSilverEfectivos"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_bronze_tbl_efectivos')]",
				"[concat(variables('factoryId'), '/datasets/ds_silver_tbl_efectivos')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_bronze_a_silver_operaciones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_tbl_operaciones",
								"type": "DatasetReference"
							},
							"name": "OrigenBronzeOperaciones"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_tbl_operaciones",
								"type": "DatasetReference"
							},
							"name": "DestinoSilverOperaciones"
						}
					],
					"transformations": [
						{
							"name": "MapeoOperaciones"
						},
						{
							"name": "ConvertirTiposOperaciones"
						}
					],
					"scriptLines": [
						"source(output(",
						"          id_operacion as integer,",
						"          nombre_operacion as string,",
						"          tipo_operacion as string,",
						"          fecha_inicio as string,",
						"          fecha_fin as string,",
						"          presupuesto_asignado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> OrigenBronzeOperaciones",
						"OrigenBronzeOperaciones select(mapColumn(",
						"          id_operacion,",
						"          nombre_operacion,",
						"          tipo_operacion,",
						"          fecha_inicio,",
						"          fecha_fin,",
						"          presupuesto_limpio = presupuesto_asignado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> MapeoOperaciones",
						"MapeoOperaciones derive(presupuesto_asignado = iif(\r",
						"  isNull(presupuesto_limpio) || trim(presupuesto_limpio) == '' || trim(presupuesto_limpio) == 'NULL',\r",
						"  toDecimal(0.0, 18, 2),\r",
						"  iif(\r",
						"    isNull(toDecimal(regexReplace(regexReplace(presupuesto_limpio, '[^0-9.]', ''), '\\\\.(?=.*\\\\.)', ''), 18, 2)),\r",
						"    toDecimal(0.0, 18, 2),\r",
						"    toDecimal(regexReplace(regexReplace(presupuesto_limpio, '[^0-9.]', ''), '\\\\.(?=.*\\\\.)', ''), 18, 2)\r",
						"  )\r",
						")) ~> ConvertirTiposOperaciones",
						"ConvertirTiposOperaciones sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          id_operacion as integer,",
						"          nombre_operacion as string,",
						"          tipo_operacion as string,",
						"          fecha_inicio as date,",
						"          fecha_fin as date,",
						"          presupuesto_asignado as decimal(18,2)",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
