{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-ucb-dw-ffaa-12341113"
		},
		"ls_destino_dw_ffaa_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_destino_dw_ffaa'"
		},
		"ls_fuente_fuerzas_armadas_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_fuente_fuerzas_armadas'"
		},
		"ls_destino_dw_ffaa_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-sisger-ffaa-12341113.database.windows.net"
		},
		"ls_destino_dw_ffaa_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_fuerzas_armadas"
		},
		"ls_destino_dw_ffaa_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "nicolas"
		},
		"ls_fuente_fuerzas_armadas_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server02-fuerzas-armadas-bolivia.database.windows.net"
		},
		"ls_fuente_fuerzas_armadas_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp-fuerzas-armadas-bolivia-2"
		},
		"ls_fuente_fuerzas_armadas_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "userSisGer"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-ucb-dw-ffaa-12341113_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_destino_dw_ffaa_password": {
						"value": "[parameters('ls_destino_dw_ffaa_password')]"
					},
					"ls_fuente_fuerzas_armadas_password": {
						"value": "[parameters('ls_fuente_fuerzas_armadas_password')]"
					},
					"ls_destino_dw_ffaa_properties_typeProperties_server": {
						"value": "[parameters('ls_destino_dw_ffaa_properties_typeProperties_server')]"
					},
					"ls_destino_dw_ffaa_properties_typeProperties_database": {
						"value": "[parameters('ls_destino_dw_ffaa_properties_typeProperties_database')]"
					},
					"ls_destino_dw_ffaa_properties_typeProperties_userName": {
						"value": "[parameters('ls_destino_dw_ffaa_properties_typeProperties_userName')]"
					},
					"ls_fuente_fuerzas_armadas_properties_typeProperties_server": {
						"value": "[parameters('ls_fuente_fuerzas_armadas_properties_typeProperties_server')]"
					},
					"ls_fuente_fuerzas_armadas_properties_typeProperties_database": {
						"value": "[parameters('ls_fuente_fuerzas_armadas_properties_typeProperties_database')]"
					},
					"ls_fuente_fuerzas_armadas_properties_typeProperties_userName": {
						"value": "[parameters('ls_fuente_fuerzas_armadas_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}